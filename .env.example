# Beyond Jersey AI Assistant Configuration
APP_NAME="Beyond Jersey AI Assistant"
DEBUG=true

# Ollama LLM Configuration
# For 8 GB RAM M1, qwen2.5:3b or qwen3:4b is highly recommended for speed and low memory footprint.
# qwen3:8b or qwen2.5:7b can also be used if memory allows.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=30.0
OLLAMA_NUM_CTX=2048

# Fallback simulation if Ollama daemon is offline (helpful during dev / test)
ALLOW_LLM_FALLBACK=true

# Database Configuration (SQLite for local MVP, easily portable to PostgreSQL/Supabase)
DATABASE_URL=sqlite:///./beyondjersey.db
